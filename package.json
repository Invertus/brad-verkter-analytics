{
  "name": "@bradsearch/brad-verkter-analytics",
  "version": "1.4.0",
  "description": "BradSearch analytics tracking provider for Verkter client storefronts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "files": [
