    "react-router-dom": ">=5"
  },
  "dependencies": {
    "@bradsearch/analytics-core": "^1.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/react": "^14.3.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "keywords": [
    "bradsearch",
    "magento",
    "pwa"
  ],
  "license": "Apache-2.0",
  "private": false,
  "author": {
    "name": "BradSearch",
    "email": "hello@bradsearch.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Invertus/brad-verkter-analytics"
  },
  "bugs": {
    "url": "https://github.com/Invertus/brad-verkter-analytics/issues"
  },
  "homepage": "https://github.com/Invertus/brad-verkter-analytics#readme",
